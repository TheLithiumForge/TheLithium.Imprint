<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Easy snapshot assertions for any .NET test framework. Includes the Native AOT runtime and source generator.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>snapshot;testing;nativeaot;xunit;nunit;mstest</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TheLithium.Imprint.Core/TheLithium.Imprint.Core.csproj" />
    <ProjectReference Include="../TheLithium.Imprint.Generator/TheLithium.Imprint.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Update="lib/net10.0/_._" Pack="true" PackagePath="lib/net10.0/_._" />
    <None Include="../TheLithium.Imprint.Generator/bin/$(Configuration)/netstandard2.0/TheLithium.Imprint.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Update="buildTransitive/TheLithium.Imprint.props" Pack="true" PackagePath="buildTransitive/TheLithium.Imprint.props" />
  </ItemGroup>
</Project>
