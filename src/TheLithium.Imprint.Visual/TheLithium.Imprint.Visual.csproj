<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Image snapshots for TheLithium.Imprint: PNG baselines, pixel comparison with tolerances and diff images. Native AOT and trim compatible.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>snapshot;testing;image;png;screenshot;nativeaot;imprint</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TheLithium.Imprint.Visual.Capture" />
    <InternalsVisibleTo Include="TheLithium.Imprint.Visual.Tests" />
    <!-- The full package brings the build task and generator, so a test that only calls AssertImage is still wrapped. -->
    <ProjectReference Include="../TheLithium.Imprint/TheLithium.Imprint.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
