<Project>
  <!-- This directory is copied outside the repository before compilation. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- The runner writes ImprintPackageVersion from the packed packages, so no version is pinned here. -->
  <Import Project="ImprintPackageVersion.props" />
</Project>
