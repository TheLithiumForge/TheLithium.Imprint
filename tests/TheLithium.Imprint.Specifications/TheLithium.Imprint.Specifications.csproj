<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAotCompatible>true</IsAotCompatible>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Engine specifications deliberately open and fail explicit integration lifetimes. -->
    <Compile Update="Specs.cs;AdditionalSpecs.cs;SecuritySpecs.cs;JsonBoundarySpecs.cs;RepresentationSpecs.cs;TransactionSpecs.cs;VisualSpecs.cs" ImprintInstrument="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackageReferences)' != 'true'">
    <ProjectReference Include="../../src/TheLithium.Imprint.Visual/TheLithium.Imprint.Visual.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackageReferences)' == 'true'">
    <PackageReference Include="TheLithium.Imprint.Visual" Version="$(Version)" />
  </ItemGroup>
</Project>
